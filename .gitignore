# Gradle
.gradle/
build/
dist/
gradle-app.setting
.gradletasknamecache

# Java
*.class
*.log
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
hs_err_pid*
replay_pid*

# Gradle wrapper jar/properties must stay tracked (needed by gradlew/gradlew.bat).
# These negations MUST come after the *.jar exclusion above — gitignore uses
# last-match-wins, so placing them earlier (as before) silently re-ignored the jar.
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# IDE - IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr
out/

# IDE - Eclipse
.classpath
.project
.settings/
bin/

# IDE - VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# OS specific
.DS_Store
Thumbs.db

# Misc
*.swp
*.bak
ghidra_docs

# Cursor Settings
.cursor/
